BOT_TOKEN=сюди_токен_від_BotFather
ADMIN_IDS=123456789,987654321
# Необов'язково: де зберігати базу (за замовчуванням data/bot.db)
# DB_PATH=data/bot.db
# Необов'язково: максимальний розмір файлу в МБ (за замовчуванням 20)
# MAX_FILE_MB=20
# Необов'язково: скільки конспектів можна додати за годину (за замовчуванням 20)
# UPLOAD_LIMIT_PER_HOUR=20
# Необов'язково: резервні копії бази (за замовчуванням: увімкнено, о 03:00 UTC, зберігати 7 копій)
# BACKUP_ENABLED=true
# BACKUP_HOUR=3
# BACKUP_KEEP=7

# --- Лише для хостингу Render (локально не потрібно) ---
# Постійна копія бази в Cloudflare R2 (Litestream). Без LITESTREAM_BUCKET реплікація вимкнена.
# LITESTREAM_BUCKET=назва_бакета
# LITESTREAM_ENDPOINT=https://ВАШ_ACCOUNT_ID.r2.cloudflarestorage.com
# LITESTREAM_ACCESS_KEY_ID=...
# LITESTREAM_SECRET_ACCESS_KEY=...
# LITESTREAM_PATH=bot-db
# Адреса для самопінгу береться з RENDER_EXTERNAL_URL автоматично; за потреби задай вручну:
# KEEPALIVE_URL=https://назва-сервісу.onrender.com
